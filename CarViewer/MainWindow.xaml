    Name: Alex Tan
    Date: Dec 3rd 2025
    Description: Car Inventory Management System
-->
    
    <Window x:Class="CarViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Inventory — COSC2100 Assignment 5"
        Width="800"
        Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar + title -->
        <DockPanel Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Save Inventory"
                              InputGestureText="Ctrl+S"
                              Click="MenuSave_Click"
                              ToolTip="Save the current vehicle inventory." />
                    <MenuItem Header="_Reload Inventory"
                              InputGestureText="Ctrl+L"
                              Click="MenuReload_Click"
                              ToolTip="Reload vehicles from persistent storage." />
                    <Separator />
                    <MenuItem Header="E_xit"
                              InputGestureText="Alt+F4"
                              Click="Exit_Click"
                              ToolTip="Close the application." />
                </MenuItem>

                <MenuItem Header="_Tools">
                    <MenuItem Header="_Clear Inputs"
                              Click="MenuClearInputs_Click"
                              ToolTip="Clear all fields on the Add Vehicles tab." />
                    <MenuItem Header="Clear _Inventory"
                              Click="MenuClearInventory_Click"
                              ToolTip="Remove all vehicles from the inventory and the data file." />
                </MenuItem>

                <MenuItem Header="_Help">
                    <MenuItem Header="_About"
                              Click="MenuAbout_Click"
                              ToolTip="Show information about this program." />
                </MenuItem>
            </Menu>

            <TextBlock Text="Vehicle Inventory"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="8,4,0,8"
                       HorizontalAlignment="Left"
                       ToolTip="Vehicle inventory management for COSC 2100." />
        </DockPanel>

        <!-- Main content -->
        <TabControl x:Name="tabControl"
                    Grid.Row="1"
                    SelectionChanged="TabControl_SelectionChanged">
            <!-- Add / Edit tab -->
            <TabItem x:Name="tabAdd"
                     Header="_Add Vehicles"
                     ToolTip="Add a new vehicle or modify an existing one.">
                <Grid Margin="8">
                    <!-- 5 rows: 3 for fields, 1 stretchy spacer, 1 for buttons -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Type -->
                        <RowDefinition Height="Auto" />
                        <!-- Make/Model -->
                        <RowDefinition Height="Auto" />
                        <!-- Year/Price/New -->
                        <RowDefinition Height="*" />
                        <!-- Spacer to push buttons down -->
                        <RowDefinition Height="Auto" />
                        <!-- Buttons -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Vehicle type -->
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="_Type:"
                           Target="{Binding ElementName=radioCar}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <RadioButton x:Name="radioCar"
                                     Content="_Car"
                                     GroupName="VehicleType"
                                     Margin="0,0,16,0"
                                     ToolTip="Select to add or modify a car."
                                     IsChecked="True"
                                     TabIndex="0" />
                        <RadioButton x:Name="radioMotorcycle"
                                     Content="_Motorcycle"
                                     GroupName="VehicleType"
                                     ToolTip="Select to add or modify a motorcycle."
                                     TabIndex="1" />
                    </StackPanel>

                    <!-- Make / Model -->
                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Content="_Make:"
                           Target="{Binding ElementName=comboMake}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <ComboBox x:Name="comboMake"
                                  Width="160"
                                  IsEditable="False"
                                  TabIndex="2"
                                  ToolTip="Select the vehicle make." />
                        <Label Content="_Model:"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               Target="{Binding ElementName=textModel}" />
                        <TextBox x:Name="textModel"
                                 Width="160"
                                 TabIndex="3"
                                 ToolTip="Enter the vehicle model." />
                    </StackPanel>

                    <!-- Year / Price / New -->
                    <Label Grid.Row="2"
                           Grid.Column="0"
                           Content="_Year:"
                           Target="{Binding ElementName=comboYear}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <ComboBox x:Name="comboYear"
                                  Width="100"
                                  IsEditable="False"
                                  TabIndex="4"
                                  ToolTip="Select the model year." />
                        <Label Content="_Price:"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               Target="{Binding ElementName=textPrice}" />
                        <TextBox x:Name="textPrice"
                                 Width="120"
                                 TabIndex="5"
                                 ToolTip="Enter the vehicle price." />
                        <CheckBox x:Name="checkIsNew"
                                  Content="_New"
                                  Margin="16,0,0,0"
                                  TabIndex="6"
                                  ToolTip="Check if the vehicle is new." />
                    </StackPanel>

                    <!-- Buttons: bottom-right -->
                    <StackPanel Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button x:Name="buttonEnter"
                                Content="_Enter"
                                Width="60"
                                Height="30"
                                Margin="0,0,8,0"
                                TabIndex="7"
                                Click="Enter_Click"
                                ToolTip="Add a new vehicle or save changes to the selected vehicle." />
                        <Button x:Name="buttonReset"
                                Content="_Reset"
                                Width="60"
                                Height="30"
                                Margin="0,0,8,0"
                                TabIndex="8"
                                Click="Reset_Click"
                                ToolTip="Clear the fields on this tab." />
                        <Button x:Name="buttonExit"
                                Content="E_xit"
                                Width="60"
                                Height="30"
                                TabIndex="9"
                                Click="Exit_Click"
                                ToolTip="Close the application." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Vehicle list tab -->
            <TabItem x:Name="tabList"
                     Header="_Vehicle List"
                     ToolTip="Browse and select vehicles currently in inventory.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                              Header="Inventory"
                              ToolTip="Select a vehicle to load its details into the Add Vehicles tab.">
                        <Grid>
                            <ListBox x:Name="listCars"
                                     Margin="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="listCars_SelectionChanged"
                                     TabIndex="10"
                                     ToolTip="Select a vehicle to edit or remove.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button x:Name="buttonRemove"
                                Content="_Remove Selected"
                                Width="130"
                                TabIndex="11"
                                Click="Remove_Click"
                                ToolTip="Remove the selected vehicle from the list and from persistent storage." />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="labelStatus"
                           Text="Ready."
                           TextWrapping="NoWrap" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
