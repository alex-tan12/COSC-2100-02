<Window x:Class="CarViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Inventory — COSC2100 Assignment 3"
        Width="800"
        Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Vehicle Inventory"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,8"
                   ToolTip="Vehicle inventory management for COSC 2100." />

        <!-- Main tabs -->
        <TabControl x:Name="tabControl"
                    Grid.Row="1"
                    SelectionChanged="TabControl_SelectionChanged">
            <!-- Add Vehicles tab -->
            <TabItem x:Name="tabAdd"
                     Header="_Add Vehicles"
                     ToolTip="Add a new vehicle or modify an existing one.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Make -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Target="{Binding ElementName=comboMake}"
                           Content="_Make:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Alt+M focuses the Make list." />
                    <ComboBox x:Name="comboMake"
                              Grid.Row="0" Grid.Column="1"
                              TabIndex="0"
                              Margin="0,0,0,4"
                              IsEditable="False"
                              ToolTip="Select the vehicle manufacturer." />

                    <!-- Model -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Target="{Binding ElementName=textModel}"
                           Content="M_odel:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Alt+O focuses the Model textbox." />
                    <TextBox x:Name="textModel"
                             Grid.Row="1" Grid.Column="1"
                             TabIndex="1"
                             Margin="0,0,0,4"
                             ToolTip="Enter the model name." />

                    <!-- Year -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Target="{Binding ElementName=comboYear}"
                           Content="_Year:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Alt+Y focuses the Year list." />
                    <ComboBox x:Name="comboYear"
                              Grid.Row="2" Grid.Column="1"
                              TabIndex="2"
                              Margin="0,0,0,4"
                              IsEditable="False"
                              ToolTip="Select the model year." />

                    <!-- Price -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Target="{Binding ElementName=textPrice}"
                           Content="_Price:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Alt+P focuses the Price textbox." />
                    <TextBox x:Name="textPrice"
                             Grid.Row="3" Grid.Column="1"
                             TabIndex="3"
                             Margin="0,0,0,4"
                             ToolTip="Enter the vehicle price in dollars." />

                    <!-- Condition -->
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="Con_dition:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Indicate whether the vehicle is new." />
                    <CheckBox x:Name="checkIsNew"
                              Grid.Row="4" Grid.Column="1"
                              TabIndex="4"
                              Content="_New vehicle"
                              Margin="0,0,0,4"
                              ToolTip="Check if the vehicle is new; otherwise it is used." />

                    <!-- Vehicle Type -->
                    <Label Grid.Row="5" Grid.Column="0"
                           Content="Vehicle _Type:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           ToolTip="Choose the type of vehicle to create." />
                    <StackPanel Grid.Row="5" Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <RadioButton x:Name="radioCar"
                                     Content="_Car"
                                     TabIndex="5"
                                     Margin="0,0,12,0"
                                     ToolTip="Create a Car object." />
                        <RadioButton x:Name="radioMotorcycle"
                                     Content="_Motorcycle"
                                     TabIndex="6"
                                     ToolTip="Create a Motorcycle object." />
                    </StackPanel>

                    <!-- Spacer row -->
                    <Border Grid.Row="6" Grid.ColumnSpan="2" />

                    <!-- Buttons -->
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="buttonEnter"
                                Content="_Enter"
                                Width="90"
                                Margin="0,0,8,0"
                                TabIndex="7"
                                Click="Enter_Click"
                                ToolTip="Alt+E or click to add or update the vehicle." />
                        <Button x:Name="buttonReset"
                                Content="_Reset"
                                Width="90"
                                Margin="0,0,8,0"
                                TabIndex="8"
                                Click="Reset_Click"
                                ToolTip="Alt+R or click to clear all fields." />
                        <Button x:Name="buttonExit"
                                Content="E_xit"
                                Width="90"
                                TabIndex="9"
                                Click="Exit_Click"
                                ToolTip="Alt+X or click to close the application." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Inventory List tab -->
            <TabItem x:Name="tabList"
                     Header="_Vehicle List"
                     ToolTip="Browse and select vehicles currently in inventory.">
                <Grid Margin="8">
                    <GroupBox Header="Inventory"
                              ToolTip="Select a vehicle to load its details into the Add Vehicles tab.">
                        <Grid>
                            <ListBox x:Name="listCars"
                                     Margin="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="listCars_SelectionChanged"
                                     TabIndex="10"
                                     ToolTip="Select a vehicle to edit.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Statistics tab -->
            <TabItem x:Name="tabStats"
                     Header="In_ventory Data"
                     ToolTip="View statistics about the current vehicle inventory.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Current inventory statistics:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Number of vehicles:"
                                   Margin="0,0,8,4" />
                        <TextBlock x:Name="textVehicleCount"
                                   Grid.Row="0" Grid.Column="1"
                                   Margin="0,0,0,4"
                                   ToolTip="Total count of vehicles currently in inventory." />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Total price of vehicles:"
                                   Margin="0,0,8,4" />
                        <TextBlock x:Name="textTotalPrice"
                                   Grid.Row="1" Grid.Column="1"
                                   Margin="0,0,0,4"
                                   ToolTip="Sum of all vehicle prices." />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Average vehicle price:"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="textAveragePrice"
                                   Grid.Row="2" Grid.Column="1"
                                   ToolTip="Average price of vehicles in inventory." />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar / result messages -->
        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Padding="6"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
            <TextBlock x:Name="labelResult"
                       TextWrapping="Wrap"
                       ToolTip="Status and validation messages appear here." />
        </Border>
    </Grid>
</Window>
